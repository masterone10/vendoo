{
  "name": "vendoor-operations-intelligence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "db:import-sqlite": "tsx server/importSqliteToSupabase.ts",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "tsx server/tests/run_all_tests.ts",
    "test:unit": "tsx server/tests/requirements_verification.test.ts && tsx server/tests/team_status_transition_dedup.test.ts && tsx server/tests/comprehensive_report_dedup_and_parity.test.ts && tsx server/tests/printed_risk_day_scoped.test.ts && tsx server/tests/orders_new_sync_and_parity_555.test.ts",
    "test:integration": "tsx server/tests/acceptance.test.ts && tsx server/tests/isolated_logs_pipeline_verification.test.ts && tsx server/tests/reports_failure_and_state_verification.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
