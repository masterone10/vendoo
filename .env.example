# Vendoor Integration Settings
VENDOOR_LOGIN_URL="https://aff.ven-door.com/dashboard/login"
VENDOOR_EMAIL="your_email@vendoor.com"
VENDOOR_PASSWORD="your_password"

# Engine & Sync Settings
PORT=3000
SYNC_INTERVAL_SECONDS=25
TIMEZONE="Africa/Cairo"
DATABASE_PATH="./data/vendoor_intelligence.sqlite"

# GEMINI_API_KEY: Optional AI Studio integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
