# Supabase PostgreSQL Database Connection
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase REST Credentials (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local SQLite fallback path (used only before Supabase configuration)
DATABASE_PATH=

# Operational Configuration
PORT=3000
SYNC_INTERVAL_SECONDS=25
TIMEZONE=Africa/Cairo

# Vendoor Operations Credentials (required for live sync)
VENDOOR_EMAIL=
VENDOOR_PASSWORD=
VENDOOR_LOGIN_URL=https://aff.ven-door.com